.DS_Store
node_modules/

# Secrets are never stored in project files or version control (SPEC.md,
# confirmed default 8); supply them via the environment or host secret storage
.env
.env.*
!.env.example

# Local-only jflow traces and evidence; never version-controlled (SPEC.md D23)
.jflow/
traces/

coverage/
*.log

# In-flight record writes; a crash may leave one behind
jflow/*.tmp

# Build output of the helper (npm run build)
dist/

# Probe file check-host writes and removes; left behind only by a crash
.jflow-host-check-*

notes.md
